# Copy to .env (or export these) for local development. Every value has a default except where noted.
DATABASE_URL=postgresql+psycopg://fluxo:fluxo@localhost:5432/fluxo
TEST_DATABASE_URL=postgresql+psycopg://fluxo:fluxo@localhost:5432/fluxo_test
APP_TIMEZONE=America/Sao_Paulo
TOKEN_TTL_DAYS=30
MAX_UPLOAD_KB=2048
# Turns on POST /api/demo/session (a private sample account per visitor).
DEMO_ENABLED=true
